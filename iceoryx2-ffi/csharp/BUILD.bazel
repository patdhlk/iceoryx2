package(default_visibility = ["//visibility:public"])

# Note: Full rules_dotnet integration requires adding rules_dotnet to MODULE.bazel.
# To enable Bazel builds for C#:
#
# 1. Add to MODULE.bazel:
#    bazel_dep(name = "rules_dotnet", version = "0.15.1")
#    dotnet = use_extension("@rules_dotnet//dotnet:extensions.bzl", "dotnet")
#    dotnet.toolchain(dotnet_version = "8.0.100")
#    use_repo(dotnet, "dotnet_toolchains")
#    register_toolchains("@dotnet_toolchains//:all")
#
# 2. Then uncomment the targets below.
#
# For now, use the .NET SDK build system: dotnet build

filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
)

filegroup(
    name = "iceoryx2-ffi-csharp-src",
    srcs = glob([
        "src/**/*.cs",
        "*.csproj",
        "*.sln",
    ]),
)

filegroup(
    name = "iceoryx2-ffi-csharp-examples",
    srcs = glob([
        "examples/**/*.cs",
        "examples/**/*.csproj",
    ]),
)

filegroup(
    name = "iceoryx2-ffi-csharp-tests",
    srcs = glob([
        "tests/**/*.cs",
        "tests/**/*.csproj",
    ]),
)

